# Copy to .env and fill secrets. DO NOT commit .env
LIVEKIT_API_KEY=teleop_dev_key
LIVEKIT_API_SECRET=replace-with-a-random-local-secret
LIVEKIT_URL=http://localhost:7880
CONTROL_LEASE_TTL_SECONDS=30
VEHICLE_LIVEKIT_TOKEN_TTL_MINUTES=30
AUTH_MODE=dev
# Set AUTH_MODE=oidc and configure all three values for production. The OIDC
# application must issue teleop:observe/teleop:control to operators and
# teleop:vehicle to device client-credential tokens.
OIDC_ISSUER=https://casdoor.example.com
OIDC_AUDIENCE=teleop-api
OIDC_JWKS_URL=https://casdoor.example.com/.well-known/jwks
# JSON array of user/tenant/vehicle permission grants. Empty or omitted denies all operator vehicle access.
VEHICLE_ACL_JSON=[{"user_id":"operator-001","tenant_id":"fleet-a","vehicle_id":"car001","permissions":["observe","control"]},{"user_id":"operator-001","tenant_id":"fleet-a","vehicle_id":"car-001","permissions":["observe","control"]}]
VEHICLE_SUBJECT_MAP_JSON={"admin/app-vehicle-app":"car-001"}
CLIENT_ORIGIN=http://127.0.0.1:8000,https://console.example.com
API_DOMAIN=gateway.example.com
RTC_DOMAIN=rtc.example.com
CASDOOR_DOMAIN=casdoor.example.com
# Address of the separately deployed Casdoor instance from the Caddy container.
CASDOOR_UPSTREAM=casdoor:8000
CASDOOR_DB_ROOT_PASSWORD=replace-with-a-random-database-password
