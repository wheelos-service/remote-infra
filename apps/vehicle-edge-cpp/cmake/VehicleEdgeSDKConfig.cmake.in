@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(VehicleAuthSDK @PROJECT_VERSION@ EXACT CONFIG)
find_dependency(VehicleTeleopSDK @PROJECT_VERSION@ EXACT CONFIG)
find_dependency(VehicleDataSDK @PROJECT_VERSION@ EXACT CONFIG)
foreach(_component config state transport auth teleop data runtime)
  set(VehicleEdgeSDK_${_component}_FOUND TRUE)
endforeach()
check_required_components(VehicleEdgeSDK)
