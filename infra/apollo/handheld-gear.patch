+TEST(TeleopE2EFlowTest, HandheldGearAndServiceBrake) {
+  using Chassis = apollo::canbus::Chassis;
+  VehicleHarness h("speed", 4.0);
+  auto now = std::chrono::steady_clock::now();
+  h.receiver.UpdateContext(MakeContext(h.public_key_b64, h.receiver.InstanceID()), now, now);
+  Chassis chassis;
+  chassis.set_driving_mode(Chassis::COMPLETE_AUTO_DRIVE);
+  chassis.set_gear_location(Chassis::GEAR_DRIVE);
+  chassis.set_speed_mps(0);
+  chassis.set_steering_percentage(0);
+  auto report = [&] {
+    chassis.mutable_header()->set_timestamp_sec(vehicle_edge::UnixMilliseconds() / 1000.0);
+    vehicle_edge::ReceiveChassis(chassis, h.cache.get(), std::chrono::steady_clock::now());
+    h.guardian.OnChassis(std::make_shared<Chassis>(chassis));
+  };
+  auto send = [&](int throttle, int brake, int direction, std::string gear = "", bool service = false) {
+    now = std::chrono::steady_clock::now();
+    const auto wall = vehicle_edge::UnixMilliseconds();
+    const auto fb = h.receiver.Receive("control-session-e2e",
+        h.SignPacket(0, throttle, brake, direction, wall, gear, service), now, now, wall);
+    EXPECT_EQ(fb["status"].asString(), "ACCEPTED");
+    h.publisher->Publish(fb);
+    auto output = h.guardian.EvaluateArbitration(h.sim_sec);
+    EXPECT_EQ(output.control_source(), apollo::guardian::CONTROL_SOURCE_REMOTE);
+    EXPECT_EQ(output.safety_override(), apollo::guardian::SAFETY_OVERRIDE_NONE);
+    return output.control_command();
+  };
+  report();
+  send(0, 20, 0);
+  h.sim_sec += 0.31;
+  auto shift = send(0, 20, 0, "R");
+  ASSERT_TRUE(shift.has_gear_location());
+  ASSERT_EQ(shift.gear_location(), Chassis::GEAR_REVERSE);
+  EXPECT_EQ(send(50, 0, 1).speed(), 0);
+  // Simulated chassis consumes the Guardian output and reports its actual gear.
+  chassis.set_gear_location(shift.gear_location());
+  report();
+  auto propel = send(50, 0, -1);
+  EXPECT_FALSE(propel.has_gear_location());
+  ASSERT_EQ(propel.speed(), 2.0);
+  chassis.set_speed_mps(chassis.gear_location() == Chassis::GEAR_REVERSE
+                            ? -propel.speed() : propel.speed());
+  report();
+  EXPECT_LT(h.cache->FreshChassisMessage()["speed_mps"].asDouble(), 0);
+  auto braking = send(0, 100, 0, "", true);
+  EXPECT_FALSE(braking.has_gear_location());
+  EXPECT_EQ(braking.brake(), 100);
+  EXPECT_FALSE(braking.parking_brake());
+  EXPECT_FALSE(braking.is_in_safe_mode());
+  EXPECT_FALSE(send(0, 20, 0, "N").has_gear_location());
+  chassis.set_speed_mps(0);
+  report();
+  EXPECT_FALSE(send(0, 0, 0).has_gear_location());
+  auto neutral = send(0, 20, 0, "N");
+  ASSERT_TRUE(neutral.has_gear_location());
+  ASSERT_EQ(neutral.gear_location(), Chassis::GEAR_NEUTRAL);
+  chassis.set_gear_location(neutral.gear_location());
+  report();
+  EXPECT_EQ(h.cache->FreshChassisMessage()["gear_location"].asString(), "GEAR_NEUTRAL");
+  EXPECT_EQ(send(100, 0, -1).speed(), 0);
+  auto drive = send(0, 20, 0, "D");
+  ASSERT_TRUE(drive.has_gear_location());
+  EXPECT_EQ(drive.gear_location(), Chassis::GEAR_DRIVE);
+  chassis.set_gear_location(Chassis::GEAR_DRIVE);
+  chassis.mutable_header()->set_timestamp_sec(vehicle_edge::UnixMilliseconds() / 1000.0 - 1.0);
+  vehicle_edge::ReceiveChassis(chassis, h.cache.get(), std::chrono::steady_clock::now());
+  EXPECT_EQ(send(100, 0, 1).speed(), 0);
+  chassis.clear_gear_location();
+  report();
+  EXPECT_EQ(send(100, 0, 1).speed(), 0);
+  EXPECT_EQ(send(0, 55, 0, "", true).brake(), 55);
+}
