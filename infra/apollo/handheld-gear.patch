+Json::Value StateCache::FreshChassisMessage() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto now = std::chrono::steady_clock::now();
+  const auto wall = UnixMilliseconds();
+  if (!chassis_.received || *chassis_.received > now ||
+      now - *chassis_.received > std::chrono::milliseconds(500) ||
+      !chassis_.source.timestamp_ms || *chassis_.source.timestamp_ms > wall ||
+      wall - *chassis_.source.timestamp_ms > 500)
+    return Json::nullValue;
   return chassis_.message;
 }

