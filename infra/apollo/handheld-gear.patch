+void GuardianComponent::EnforceRemoteGearInterlock(double now_sec, ControlCommand* cmd) const {
+  const bool fresh = has_chassis_ && chassis_.has_gear_location() &&
+      IsTimestampFresh(chassis_.header().timestamp_sec(), now_sec, 500.0);
+  const auto gear = chassis_.gear_location();
+  const bool propulsion = fresh &&
+      (gear == Chassis::GEAR_DRIVE || gear == Chassis::GEAR_REVERSE);
+  // Receivers predating explicit shifts can repeat the measured gear on motion.
+  if (fresh && cmd->has_gear_location() && cmd->gear_location() == gear) {
+    cmd->clear_gear_location();
+  }
+  if (!propulsion || cmd->has_gear_location() || teleop_cmd_.throttle() == 0)
+    cmd->set_throttle(0.0);
+  if (!propulsion || cmd->has_gear_location()) cmd->set_speed(0.0);
+  if (!cmd->has_gear_location()) return;
+  if (!fresh || (!propulsion && gear != Chassis::GEAR_NEUTRAL && gear != Chassis::GEAR_PARKING) ||
+      safety_override_ != SAFETY_OVERRIDE_NONE || !chassis_.has_speed_mps() ||
+      !std::isfinite(chassis_.speed_mps()) ||
+      std::fabs(chassis_.speed_mps()) > guardian_conf_.max_stationary_speed_mps() ||
+      cmd->brake() < guardian_conf_.min_gear_shift_brake_pct()) {
+    cmd->clear_gear_location();
   }
 }

